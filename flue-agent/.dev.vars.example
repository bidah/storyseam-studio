# Copy to .dev.vars for local `flue dev` / `wrangler dev` (never commit .dev.vars).
# Prod: set these with `wrangler secret put <NAME>`.

# Anthropic key used by the built-in `anthropic/*` provider.
ANTHROPIC_API_KEY=""

# Cloudflare AI Gateway anthropic endpoint. When set, app.ts routes anthropic/*
# through the gateway (caching/logging/limits). Leave empty to call Anthropic
# directly. Shape:
#   https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/anthropic
ANTHROPIC_GATEWAY_URL=""

# OpenRouter key used by the built-in `openrouter/*` provider (the opt-in
# Settings › Chat provider = OpenRouter, e.g. DeepSeek V4 Pro). Required for any
# openrouter/* turn; without it that turn errors.
OPENROUTER_API_KEY=""

# Cloudflare AI Gateway OpenRouter endpoint. When set, app.ts routes openrouter/*
# through the gateway (caching/logging/limits); the gateway forwards
# OPENROUTER_API_KEY to OpenRouter as the Bearer token. Leave empty to call
# OpenRouter directly. Shape:
#   https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/openrouter
OPENROUTER_GATEWAY_URL=""

# Shared HMAC secret with the shot-studio-uploads worker. MUST match that
# worker's FLUE_PROXY_SECRET (formerly EVE_PROXY_SECRET).
FLUE_PROXY_SECRET=""

# Base URL of the shot-studio-uploads worker JSON API the tools call.
SHOT_STUDIO_API="http://localhost:3334"

# Daytona sandbox (optional). Without it, bash uses flue's in-memory sandbox.
DAYTONA_API_KEY=""

# Higgsfield generation MCP endpoint (OAuth-protected; token bridged from worker).
HIGGSFIELD_MCP_URL=""

# Web search — the agent's web_search / fetch_url tools. Exactly ONE backend
# loads per conversation, chosen in Settings › Web search. These are the
# OPERATOR fallbacks; a user's own key (BYOK, localStorage → x-flue-exa-key /
# x-flue-firecrawl-key) wins when present. With neither, that backend is absent.
EXA_API_KEY=""
FIRECRAWL_API_KEY=""
