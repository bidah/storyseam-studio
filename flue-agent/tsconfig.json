{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2024"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", ".flue"]
}
