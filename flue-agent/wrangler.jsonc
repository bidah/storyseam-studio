{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shot-studio-flue",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  // Flue generates the Durable Object classes + FLUE_* bindings; we only declare
  // migrations for them. `whistlewood.ts` -> class FlueWhistlewoodAgent.
  // `FlueRegistry` is Flue-internal and must be in the first migration.
  // Never reorder/rewrite deployed entries; append a new tag when adding agents.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FlueRegistry", "FlueWhistlewoodAgent"]
    }
  ],
  // Workers AI binding — powers the `cloudflare/@cf/…` chat models (Kimi K2.6 et
  // al.), billed to this account, auto-routed through Cloudflare AI Gateway. No
  // external model API key needed.
  "ai": { "binding": "AI" },
  // Capture console output (incl. the observe() error lines in app.ts) in
  // Cloudflare Workers Logs — visible in the dashboard Logs tab and `wrangler
  // tail`. The main shot-studio-uploads worker already has this; the agent
  // worker didn't, so failed runs left no trace here.
  "observability": { "enabled": true },
  // Non-secret config. Secrets (FLUE_PROXY_SECRET; plus ANTHROPIC_API_KEY only if
  // you re-add an anthropic/* model) are set with `wrangler secret put`.
  "vars": {
    "SHOT_STUDIO_API": "https://shot-studio-uploads.rodrigofigueroa-name.workers.dev",
    "HIGGSFIELD_MCP_URL": "https://mcp.higgsfield.ai/mcp"
  }
  // Secrets (set with `wrangler secret put` in prod, `.dev.vars` locally):
  //   ANTHROPIC_API_KEY      - Anthropic key (used by the anthropic provider)
  //   ANTHROPIC_GATEWAY_URL  - CF AI Gateway anthropic endpoint (optional; enables gateway routing)
  //   FLUE_PROXY_SECRET      - shared HMAC key with the shot-studio-uploads worker
  //   SHOT_STUDIO_API        - base URL of the shot-studio-uploads worker JSON API
  //   DAYTONA_API_KEY        - Daytona sandbox creds (optional; bash falls back to in-memory sandbox)
  //   HIGGSFIELD_MCP_URL     - Higgsfield generation MCP endpoint
}
