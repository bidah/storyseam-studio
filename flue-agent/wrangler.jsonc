{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // A SECOND worker, deployed alongside the flue-1 `shot-studio-flue`, which
  // stays live and untouched. flue 2 stores persisted schema version 8 and the
  // runtime REJECTS a version-5 (beta) database before any application code
  // runs — there is no in-place upgrade, so upgrading the old worker would
  // destroy every existing chat transcript. Instead the /eve proxy routes each
  // chat to its own engine (worker/src/routes/chats.js `engine` column), old
  // chats keep working on v1, and rollback is a flag flip rather than a
  // migration. See plans/flue-2-migration.md §1 option C.
  "name": "shot-studio-flue-v2",
  // Flue 2 validates this at build time: minimum 2026-04-01.
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  // Flue generates the Durable Object classes + FLUE_* bindings; we only declare
  // migrations for them. `Whistlewood.agentName = "whistlewood"` -> class
  // FlueWhistlewoodAgent. `FlueRegistry` is GONE in flue 2 (it indexed workflow
  // runs) — a fresh worker must not declare it at all.
  // Never reorder/rewrite deployed entries; append a new tag when adding agents.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FlueWhistlewoodAgent"]
    },
    {
      // agents/writers-room.ts — one instance per Deep Film pass.
      "tag": "v2",
      "new_sqlite_classes": ["FlueWritersRoomAgent"]
    }
  ],
  // Workers AI binding — powers the `cloudflare/@cf/…` chat models (Kimi K2.6 et
  // al.), billed to this account, auto-routed through Cloudflare AI Gateway. No
  // external model API key needed.
  "ai": { "binding": "AI" },
  // A writers' room waits on its passes with flue's init().read(), which
  // long-polls the agent about once a second — and a round's passes wait side
  // by side in ONE workflow invocation. At the default 1,000 subrequests per
  // invocation, four readers exhausted it in minutes ("Too many API requests
  // by single Worker invocation") and killed the room (film-a45e1cb9,
  // 2026-09-29). Paid plans allow up to 10M.
  "limits": { "subrequests": 100000 },
  // The Deep Film's writers' room (src/cloudflare.ts WritersRoomWorkflow):
  // started by the main worker's Film job through POST /rooms/:id (app.ts).
  "workflows": [
    {
      "name": "shot-studio-writers-room",
      "binding": "WRITERS_ROOM",
      "class_name": "WritersRoomWorkflow"
    },
    {
      // Every Film's Script stage (src/cloudflare.ts FilmScriptWorkflow):
      // outline → draft → revise, started through POST /scripts/:id.
      "name": "shot-studio-film-script",
      "binding": "FILM_SCRIPT",
      "class_name": "FilmScriptWorkflow"
    }
  ],
  // Capture console output (incl. the observe() error lines in app.ts) in
  // Cloudflare Workers Logs — visible in the dashboard Logs tab and `wrangler
  // tail`. The main shot-studio-uploads worker already has this; the agent
  // worker didn't, so failed runs left no trace here.
  "observability": { "enabled": true },
  // Non-secret config. Secrets (FLUE_PROXY_SECRET; plus ANTHROPIC_API_KEY only if
  // you re-add an anthropic/* model) are set with `wrangler secret put`.
  "vars": {
    "SHOT_STUDIO_API": "https://storyseam.app",
    "HIGGSFIELD_MCP_URL": "https://mcp.higgsfield.ai/mcp"
  }
  // Secrets (set with `wrangler secret put` in prod, `.dev.vars` locally):
  //   ANTHROPIC_API_KEY      - Anthropic key (used by the anthropic provider)
  //   ANTHROPIC_GATEWAY_URL  - CF AI Gateway anthropic endpoint (optional; enables gateway routing)
  //   CEREBRAS_API_KEY       - Cerebras key (used by the cerebras/* models — the opt-in
  //                            Settings › Chat provider choice). Required for cerebras turns.
  //   CEREBRAS_GATEWAY_URL   - CF AI Gateway Cerebras endpoint (optional; enables gateway routing):
  //                            https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/cerebras
  //   OPENROUTER_API_KEY     - OpenRouter key (used by the openrouter/* models — the opt-in
  //                            Settings › Chat provider choice, e.g. DeepSeek V4 Pro). Required
  //                            for openrouter turns.
  //   OPENROUTER_GATEWAY_URL - CF AI Gateway OpenRouter endpoint (optional; enables gateway routing):
  //                            https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/openrouter
  //   FLUE_PROXY_SECRET      - shared HMAC key with the shot-studio-uploads worker
  //   SHOT_STUDIO_API        - base URL of the shot-studio-uploads worker JSON API
  //   DAYTONA_API_KEY        - Daytona sandbox creds (optional; bash falls back to in-memory sandbox)
  //   HIGGSFIELD_MCP_URL     - Higgsfield generation MCP endpoint
  //   FAL_KEY                - OPTIONAL fal.ai fallback key. Primary path is BYOK:
  //                            the user's key arrives as x-flue-fal-key and is kept
  //                            in the conversation DO (lib/fal-key.ts), not here.
  //   ATLAS_KEY              - OPTIONAL Atlas Cloud fallback key — same BYOK model,
  //                            header x-flue-atlas-key (lib/atlas-key.ts).
  //   EXA_API_KEY            - OPTIONAL operator fallback for Exa web search
  //   FIRECRAWL_API_KEY      - OPTIONAL operator fallback for Firecrawl web search
  //                            Primary path for both is BYOK (x-flue-exa-key /
  //                            x-flue-firecrawl-key → lib/search-prefs.ts). Which
  //                            backend serves web_search / fetch_url is the user's
  //                            Settings › Web search choice (lib/search.ts).
}
