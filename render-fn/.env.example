# shot-studio render-fn — Vercel env vars. Set these with `vercel env add <NAME>`
# (or in the Vercel dashboard → Project → Settings → Environment Variables).

# --- Vercel Sandbox credentials ---------------------------------------------
# Used by @remotion/vercel to spin up the render sandbox. When this function
# runs ON Vercel, OIDC is used automatically and these can be omitted; set them
# for local `vercel dev` or cross-project sandbox access.
# Create a token at https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# --- Vercel Blob (render staging) -------------------------------------------
# The detached render writes the finished mp4 here; we then copy it to R2.
# Storage → Blob → create a store → read/write token. REQUIRED.
BLOB_READ_WRITE_TOKEN=

# --- Cloudflare R2 (final destination) --------------------------------------
# Same credentials the Express server uses. If ALL of these are set, the mp4 is
# copied Blob → R2 under `outputKey` and the R2 public URL is returned. If any
# are missing, the function returns the Vercel Blob URL instead and the Worker
# is expected to copy it to R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
