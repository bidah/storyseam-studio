{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shot-studio-uploads",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  // nodejs_compat: needed by @daytona/sdk (Buffer/axios) when the ffmpeg
  // orchestration moves onto the Worker (Stage 3).
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Non-secret config. Secrets are set with `wrangler secret put <NAME>`:
  //   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY  (presign R2 for the
  //     Daytona ffmpeg sandbox — see src/lib/ffmpeg.js)
  //   DAYTONA_API_KEY                (ffmpeg orchestration)
  //   HIGGSFIELD_MCP_TOKEN           (optional; static-login shortcut)
  //   GOOGLE_CLIENT_SECRET           ("Sign in with Google" — the OAuth client
  //     secret pairing GOOGLE_CLIENT_ID below. Create a Web application OAuth
  //     client in Google Cloud Console with redirect URI
  //     <WORKER_PUBLIC_URL>/api/auth/callback/google.)
  //   FAL_KEY                        (OPTIONAL fal.ai fallback key. The primary
  //     path is BYOK: each user's own key rides per-request as x-fal-key from
  //     their browser's localStorage and is never stored server-side. This env
  //     secret only backstops requests without one — dev / single-tenant use.)
  //   ATLAS_KEY                      (OPTIONAL Atlas Cloud fallback key — same
  //     BYOK model as FAL_KEY, header x-atlas-key. See src/lib/atlas.js.)
  //   MCP_TOKEN                      (bearer token for POST /api/mcp, the MCP
  //     server that lets Claude Desktop / Claude Code / Cursor drive the
  //     pipeline. UNSET = the endpoint is CLOSED, not open — see docs/mcp.md.)
  //   EVE_PROXY_SECRET / FLUE_PROXY_SECRET  (signs the x-flue-proxy-user token so
  //     the flue agent worker trusts the Better Auth user id across the /eve/*
  //     proxy — set the SAME value on the shot-studio-flue worker; without it the
  //     flue agent rejects with 401. FLUE_PROXY_SECRET is preferred; EVE_PROXY_SECRET
  //     is still read as a fallback so the provisioned value keeps working.)
  "vars": {
    "R2_BUCKET": "shot-studio-uploads",
    "R2_ACCOUNT_ID": "cda687c8b568323a9b535ca44a192131",
    "WORKER_PUBLIC_URL": "https://shot-studio-uploads.rodrigofigueroa-name.workers.dev",
    "HIGGSFIELD_CLIENT_ID": "LgvtzrTQ0pgrGOzD",
    // Google OAuth web client for "Sign in with Google" (secret is the
    // GOOGLE_CLIENT_SECRET wrangler secret). Empty = Google sign-in disabled.
    "GOOGLE_CLIENT_ID": "129695414931-4246hslp031dt7b60hfqkshjictku359.apps.googleusercontent.com",
    // Higgsfield MCP endpoint — the Worker calls its show_generations tool with
    // the user's OAuth bearer for the library's "Import from Higgsfield" tab.
    "HIGGSFIELD_MCP_URL": "https://mcp.higgsfield.ai/mcp",
    // The flue chat agent runs as its own Cloudflare Worker; this Worker proxies
    // /eve/* to it (stripping the prefix) so the browser reaches it same-origin
    // (see the /eve/* proxy in src/index.js).
    "FLUE_ORIGIN": "https://shot-studio-flue.rodrigofigueroa-name.workers.dev"
  },
  // Service binding to the flue chat agent Worker. The /eve/* proxy dispatches
  // through this binding (c.env.FLUE.fetch) instead of a public-URL fetch, which
  // avoids worker-to-worker DNS/Host routing (the public-URL path 404'd in prod).
  // Falls back to fetch(FLUE_ORIGIN) when the binding is absent (e.g. local dev
  // where flue runs as a separate `flue dev` process).
  "services": [
    { "binding": "FLUE", "service": "shot-studio-flue" }
  ],
  // Serve the built Vite SPA from the Worker; API routes below take precedence,
  // and client-side routes fall back to index.html.
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Force API/media/auth routes to the Worker BEFORE the SPA asset layer.
    // Otherwise a top-level navigation (e.g. the OAuth callback) hits the SPA
    // fallback (index.html) instead of the Worker, and the code is never exchanged.
    // NOTE: "/projects", "/projects/*" and "/script" were intentionally removed
    // here so those top-level paths fall through to the SPA (they are React
    // Router client routes). The APIs live under "/api/*" (matched above).
    "run_worker_first": [
      "/api/*", "/files/*", "/gen/*", "/media/*", "/sound-media/*", "/final/*",
      "/refs/*", "/multishot-media/*", "/stills/*", "/storyboard-media/*", "/visual-media/*", "/proxy/*", "/asset/*", "/thumb/*", "/hf-thumb/*",
      "/ingest/*", "/ingest-mpu/*", "/eve/*", "/upload", "/uploads", "/healthz",
      "/desktop/updates/*"
    ]
  },
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "shot-studio-uploads" }
  ],
  // Workers AI — powers the /api/transcribe Whisper speech-to-text endpoint
  // (the mobile chat composer's voice-message mic).
  "ai": { "binding": "AI" },
  // KV for Better Auth (sessions secondary storage + rate limiting).
  "kv_namespaces": [
    { "binding": "AUTH_KV", "id": "4be9b787dc844a14a14d242b54ef7ca2" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shot-studio-uploads",
      "database_id": "248c977c-1beb-4ae8-9995-c4959219bd49"
    }
  ],
  // Per-project SSE live-sync (script + timeline) — replaces the Express
  // in-memory client sets, which can't work across Worker isolates.
  "durable_objects": {
    "bindings": [{ "name": "PROJECT_EVENTS", "class_name": "ProjectEvents" }]
  },
  "migrations": [{ "tag": "v1", "new_classes": ["ProjectEvents"] }]
}
