# The `agents` SDK declares the Cloudflare chat stack (@cloudflare/ai-chat →
# @ai-sdk/react → ai@7) as OPTIONAL peers while itself peer-depending on ai@^6.
# We use only `agents/mcp` (the McpAgent for the remote-MCP connector), never the
# chat agent, so that optional branch is dead weight — but npm's strict peer
# resolver still tries to reconcile it and dead-locks. Skip it: the peers we
# actually import (agents/mcp, @modelcontextprotocol/sdk) resolve cleanly.
legacy-peer-deps=true
