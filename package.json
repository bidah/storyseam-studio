{
  "name": "shot-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "cd worker && npx wrangler dev",
    "worker:deploy": "npm run build && cd worker && npx wrangler deploy",
    "start": "vite",
    "flue:dev": "npm --prefix flue-agent run dev",
    "flue:build": "npm --prefix flue-agent run build",
    "flue:deploy": "npm --prefix flue-agent run deploy",
    "stack": "concurrently -k -n FLUE,WORKER,WEB -c magenta,blue,green \"npm run flue:dev\" \"npm run worker:dev\" \"npm run dev\"",
    "desktop:dev": "concurrently -k -n WEB,APP -c green,cyan \"npm run dev\" \"npm --prefix desktop run dev\"",
    "desktop:start": "npm run build && npm --prefix desktop run start",
    "desktop:dist": "npm run build && npm --prefix desktop run dist",
    "desktop:publish": "npm run desktop:dist && npm --prefix desktop run publish-updates",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:web": "vitest run --project web",
    "test:worker": "vitest run --project worker",
    "test:flue": "vitest run --project flue",
    "test:e2e": "playwright test",
    "test:evals": "vitest run --config evals/vitest.config.ts"
  },
  "dependencies": {
    "@daytona/sdk": "^0.195.0",
    "@flue/react": "^1.0.0-beta.9",
    "@flue/sdk": "^1.0.0-beta.9",
    "@remotion/bundler": "^4.0.486",
    "@remotion/media": "^4.0.486",
    "@remotion/player": "^4.0.486",
    "@remotion/renderer": "^4.0.486",
    "@remotion/vercel": "^4.0.486",
    "@tiptap/core": "^3.27.3",
    "@tiptap/extension-color": "^3.27.3",
    "@tiptap/extension-document": "^3.27.3",
    "@tiptap/extension-list": "^3.27.3",
    "@tiptap/extension-placeholder": "^3.27.3",
    "@tiptap/extension-text-style": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@tiptap/suggestion": "^3.27.3",
    "@xyflow/react": "^12.11.2",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.19.2",
    "glowing": "^0.2.3",
    "lucide-react": "^1.23.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.1",
    "remark-breaks": "^4.0.0",
    "remotion": "^4.0.486",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.0.1",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
