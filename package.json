{
  "name": "shot-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "concurrently -k -n API,WEB -c blue,green \"npm run server\" \"npm run dev\"",
    "agent:build": "eve build",
    "agent:start": "eve start --port 2000",
    "agent:dev": "eve dev --no-ui --port 2000",
    "stack": "bash scripts/dev-all.sh"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.5",
    "ai": "^7.0.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eve": "^0.20.0",
    "express": "^4.19.2",
    "just-bash": "^3.0.2",
    "lucide-react": "^1.23.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vite": "^5.4.0"
  }
}
