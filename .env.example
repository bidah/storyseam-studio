# Shot Studio agent (eve) — copy to `.env` and fill in.

# --- Model credential (REQUIRED for the chat to reply) -----------------------
# The agent model is `anthropic/claude-sonnet-5` via the Vercel AI Gateway.
# Provide ONE of:
#   1) An AI Gateway API key (create at https://vercel.com/dashboard/ai/api-keys)
AI_GATEWAY_API_KEY=
#   2) …or run `vercel login && vercel link` in shot-studio/ to populate a
#      VERCEL_OIDC_TOKEN automatically (no value needed here).
#   3) …or switch agent/agent.ts to a direct provider and set that key, e.g.:
# ANTHROPIC_API_KEY=

# --- eve agent base URL ------------------------------------------------------
# Origin eve mints its callback/webhook URLs on (e.g. the Higgsfield OAuth
# sign-in redirect). Must match where the eve agent listens (npm run stack uses
# :2000). Without these, eve defaults to :3000 and the sign-in redirect 404s.
# WORKFLOW_LOCAL_BASE_URL is the one that governs the connection-auth callback.
WORKFLOW_LOCAL_BASE_URL=http://localhost:2000
EVE_BASE_URL=http://localhost:2000

# --- Higgsfield generation MCP -----------------------------------------------
# The render skills (seed-audio, generate-multishot, …) drive this MCP.
# HIGGSFIELD_MCP_URL points at the Higgsfield MCP endpoint (leave unset to run
# the pipeline without live generation). The endpoint is OAuth-protected — no
# API key: the user signs in from the chat the first time a render tool runs.
# HIGGSFIELD_MCP_TOKEN is an optional pre-provisioned bearer that bypasses the
# interactive sign-in (CI / service use).
HIGGSFIELD_MCP_URL=
HIGGSFIELD_MCP_TOKEN=

# --- fal.ai (second generation provider) -------------------------------------
# OPTIONAL fallback key from https://fal.ai/dashboard/keys. The primary path is
# BYOK: each signed-in user pastes their OWN fal key in the app (mandatory
# post-login screen / Settings); it lives in their browser's localStorage and
# rides per-request — never stored server-side. Set this only to backstop
# requests without a user key (dev / single-tenant).
FAL_KEY=

# --- Atlas Cloud (third generation provider) ---------------------------------
# OPTIONAL fallback key from https://www.atlascloud.ai/console/api-keys. Same
# BYOK model as FAL_KEY: users paste their own Atlas key in the app; this env
# secret only backstops requests without one (dev / single-tenant).
ATLAS_KEY=

# --- Shot Studio data API ----------------------------------------------------
# Where the agent tools reach the Express server (default is fine locally).
# SHOT_STUDIO_API=http://localhost:3334

# --- Chat attachments → Cloudflare R2 ----------------------------------------
# The agent chat's attachment button uploads images to this R2 bucket and sends
# the resulting public URL to the model. All five are REQUIRED for uploads to
# work (POST /api/upload returns 501 until they are set).
#   R2_ACCOUNT_ID      — your Cloudflare account id
#   R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY — an R2 API token (S3 credentials)
#   R2_BUCKET          — the bucket name to store uploads in
#   R2_PUBLIC_BASE_URL — the bucket's PUBLIC origin (an https://<id>.r2.dev URL
#                        or a custom domain). Must be publicly reachable so the
#                        model can fetch the uploaded image. No trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Chat attachments → Cloudflare Worker (preferred) ------------------------
# The `worker/` project is an R2 + D1 backed upload endpoint (deploy it with
# `cd worker && npm i && npm run deploy`). Point the chat at its /upload route;
# when set it overrides the Express R2 endpoint above. It's a VITE_ var so the
# browser can read it — restart `npm run dev` after changing.
#   VITE_UPLOAD_URL=https://shot-studio-uploads.<subdomain>.workers.dev/upload
VITE_UPLOAD_URL=

# --- Script tab → Cloudflare Worker (R2 object) -----------------------------
# The screenplay document is persisted to the same Worker's /script route (an
# R2 object). The Express API auto-derives it from VITE_UPLOAD_URL's origin, so
# you normally don't set this — just (re)deploy the worker so /script exists:
# `cd worker && npm run deploy`. Set SCRIPT_STORE_URL only to point the script
# at a different Worker/origin than the uploads one. If neither the Worker is
# reachable nor this is set, the script falls back to a local script.json.
#   SCRIPT_STORE_URL=https://shot-studio-uploads.<subdomain>.workers.dev/script
SCRIPT_STORE_URL=

# --- Per-project data location ----------------------------------------------
# Base folder for per-project data (script/shotlist/sounds/selections/media).
# Defaults to the repo root, so `p_default` maps to the existing sibling folders.
# In a container (Render), point this at a persistent disk so data survives
# redeploys. See Dockerfile / render.yaml.
#   SHOT_STUDIO_DATA_HOME=/data
SHOT_STUDIO_DATA_HOME=

# --- Heavy jobs (ffmpeg / Remotion) backend ---------------------------------
# Where trim/stitch/probe (and, later, Remotion renders) run:
#   local   — child_process on this machine (default; needs ffmpeg installed)
#   daytona — a reused Daytona sandbox (ffmpeg preinstalled), staged over the API
# Set RENDER_BACKEND=daytona and provide a Daytona API key to offload the work.
RENDER_BACKEND=local
DAYTONA_API_KEY=
# Optional: a prebuilt Daytona snapshot name that already has ffmpeg (skips the
# per-first-run image build). Leave unset to build a debian-slim + ffmpeg image.
DAYTONA_SNAPSHOT=
# Optional: override the Daytona API endpoint / region.
#   DAYTONA_API_URL=
#   DAYTONA_TARGET=

# --- Remotion "Deliver" render backend --------------------------------------
# Where the editor's Remotion render runs:
#   local  — @remotion/renderer in this process (headless Chrome here; default)
#   vercel — Remotion's Vercel Sandbox (@remotion/vercel): Chrome + ffmpeg in a
#            sandbox, output stored in Vercel Blob, downloaded back.
REMOTION_BACKEND=local
# Vercel credentials for the sandbox (from a Vercel token; on Vercel, OIDC is
# used automatically instead). Create a token at vercel.com/account/tokens.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# Vercel Blob store the finished render is written to (Storage → Blob → token).
BLOB_READ_WRITE_TOKEN=
# The PUBLIC base URL of THIS server (e.g. the Render deployment). The remote
# sandbox's headless browser fetches the timeline media (/gen, /sound-media…)
# from here, so it must be internet-reachable. Required when REMOTION_BACKEND=vercel.
#   PUBLIC_MEDIA_ORIGIN=https://shot-studio.onrender.com
PUBLIC_MEDIA_ORIGIN=
