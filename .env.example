# Shot Studio agent (eve) — copy to `.env` and fill in.

# --- Model credential (REQUIRED for the chat to reply) -----------------------
# The agent model is `anthropic/claude-sonnet-5` via the Vercel AI Gateway.
# Provide ONE of:
#   1) An AI Gateway API key (create at https://vercel.com/dashboard/ai/api-keys)
AI_GATEWAY_API_KEY=
#   2) …or run `vercel login && vercel link` in shot-studio/ to populate a
#      VERCEL_OIDC_TOKEN automatically (no value needed here).
#   3) …or switch agent/agent.ts to a direct provider and set that key, e.g.:
# ANTHROPIC_API_KEY=

# --- eve agent base URL ------------------------------------------------------
# Origin eve mints its callback/webhook URLs on (e.g. the Higgsfield OAuth
# sign-in redirect). Must match where the eve agent listens (npm run stack uses
# :2000). Without these, eve defaults to :3000 and the sign-in redirect 404s.
# WORKFLOW_LOCAL_BASE_URL is the one that governs the connection-auth callback.
WORKFLOW_LOCAL_BASE_URL=http://localhost:2000
EVE_BASE_URL=http://localhost:2000

# --- Higgsfield generation MCP -----------------------------------------------
# The render skills (seed-audio, generate-multishot, …) drive this MCP.
# HIGGSFIELD_MCP_URL points at the Higgsfield MCP endpoint (leave unset to run
# the pipeline without live generation). The endpoint is OAuth-protected — no
# API key: the user signs in from the chat the first time a render tool runs.
# HIGGSFIELD_MCP_TOKEN is an optional pre-provisioned bearer that bypasses the
# interactive sign-in (CI / service use).
HIGGSFIELD_MCP_URL=
HIGGSFIELD_MCP_TOKEN=

# --- Shot Studio data API ----------------------------------------------------
# Where the agent tools reach the Express server (default is fine locally).
# SHOT_STUDIO_API=http://localhost:3334

# --- Chat attachments → Cloudflare R2 ----------------------------------------
# The agent chat's attachment button uploads images to this R2 bucket and sends
# the resulting public URL to the model. All five are REQUIRED for uploads to
# work (POST /api/upload returns 501 until they are set).
#   R2_ACCOUNT_ID      — your Cloudflare account id
#   R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY — an R2 API token (S3 credentials)
#   R2_BUCKET          — the bucket name to store uploads in
#   R2_PUBLIC_BASE_URL — the bucket's PUBLIC origin (an https://<id>.r2.dev URL
#                        or a custom domain). Must be publicly reachable so the
#                        model can fetch the uploaded image. No trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
