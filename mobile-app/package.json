  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "ios:device": "APP_VARIANT=development expo run:ios --device \"Iphone roro\"",
    "build:dev": "eas build --profile development --platform ios",
    "build:dev:sim": "eas build --profile simulator --platform ios",
    "build:preview": "eas build --profile preview --platform ios",
    "ios:release": "expo run:ios --configuration Release --device",
    "web": "expo start --web",
    "lint": "expo lint",
    "sync:suggestions": "node scripts/sync-suggestions.mjs",
    "update:dev": "eas update --channel development --platform ios",
    "update:preview": "eas update --channel preview --platform ios --environment preview --message \"$(git log -1 --pretty=%s)\"",
    "update:production": "eas update --channel production --platform ios",
    "postinstall": "patch-package"
  },
  "private": true
